# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-new-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-new-supabase-anon-public-key

# Razorpay Configuration
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Never add a Supabase service_role key with REACT_APP_.
# Service-role keys are admin secrets and must only be used in server-only code.

# iThink Logistics is used only inside the Supabase Edge Function.
# Set these with `supabase secrets set ...`; do not add them as REACT_APP_* values.
ITHINK_ENVIRONMENT=staging
ITHINK_ACCESS_TOKEN=your_ithink_access_token
ITHINK_SECRET_KEY=your_ithink_secret_key
ITHINK_PICKUP_ADDRESS_ID=1293
ITHINK_RETURN_ADDRESS_ID=1293
ITHINK_LOGISTICS=
ITHINK_SERVICE_TYPE=
ITHINK_ADMIN_EMAILS=admin@example.com
ITHINK_DEFAULT_LENGTH_CM=10
ITHINK_DEFAULT_WIDTH_CM=10
ITHINK_DEFAULT_HEIGHT_CM=5
ITHINK_DEFAULT_WEIGHT=0.5
